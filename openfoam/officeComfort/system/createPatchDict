FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cuts the air terminals, the lights and the window out of the room
// boundary. Each zone is a thin box around the boundary plane so that only
// boundary faces are selected.

patches
{
    // 4-way ceiling diffuser (600 x 600 module) at the room centre,
    // modelled as four 0.4 m x 0.05 m slots, one per discharge direction
    supply_xPos
    {
        patchInfo { type patch; }
        constructFrom zone;
        zone
        {
            type        box;
            box         (2.70 1.80 2.799) (2.75 2.20 2.801);
        }
    }

    supply_xNeg
    {
        patchInfo { type patch; }
        constructFrom zone;
        zone
        {
            type        box;
            box         (2.25 1.80 2.799) (2.30 2.20 2.801);
        }
    }

    supply_yPos
    {
        patchInfo { type patch; }
        constructFrom zone;
        zone
        {
            type        box;
            box         (2.30 2.20 2.799) (2.70 2.25 2.801);
        }
    }

    supply_yNeg
    {
        patchInfo { type patch; }
        constructFrom zone;
        zone
        {
            type        box;
            box         (2.30 1.75 2.799) (2.70 1.80 2.801);
        }
    }

    // Ceiling return grille 0.6 m x 0.3 m near the corridor wall
    return
    {
        patchInfo { type patch; }
        constructFrom zone;
        zone
        {
            type        box;
            box         (4.2 3.4 2.799) (4.8 3.7 2.801);
        }
    }

    // Four recessed 600 x 600 LED panels
    lights
    {
        patchInfo { type wall; }
        constructFrom zone;
        zone
        {
            type        box;
            boxes
            (
                (0.9 0.7 2.799) (1.5 1.3 2.801)
                (3.5 0.7 2.799) (4.1 1.3 2.801)
                (0.9 2.7 2.799) (1.5 3.3 2.801)
                (3.5 2.7 2.799) (4.1 3.3 2.801)
            );
        }
    }

    // 3.0 m x 1.4 m window in the facade, sill at 0.9 m
    window
    {
        patchInfo { type wall; }
        constructFrom zone;
        zone
        {
            type        box;
            box         (1.0 -0.001 0.9) (4.0 0.001 2.3);
        }
    }
}

