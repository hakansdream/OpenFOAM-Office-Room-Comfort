FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       off;

// Furniture and people are simple boxes; replace them with STL/OBJ files
// for real geometry. Box faces are kept off the cell-centre planes of the
// background mesh (z = 0.05, 0.15, ...) so that snappyHexMesh detects every
// intersection reliably.
geometry
{
    // Desks: 1.6 m x 0.8 m, 4 cm thick top at 0.74 m (legs not modelled)
    deskA
    {
        type box;
        min  (0.5 0.9 0.70);
        max  (2.1 1.7 0.74);
    }
    deskB
    {
        type box;
        min  (2.9 0.9 0.70);
        max  (4.5 1.7 0.74);
    }

    // Computer + monitor on each desk (the bottom overlaps the desk top)
    pcA
    {
        type box;
        min  (1.0 1.0 0.72);
        max  (1.6 1.2 1.1);
    }
    pcB
    {
        type box;
        min  (3.4 1.0 0.72);
        max  (4.0 1.2 1.1);
    }

    // Seated occupants (simplified box manikins, 1.3 m tall)
    personA
    {
        type box;
        min  (1.1 1.8 -0.1);
        max  (1.5 2.2 1.3);
    }
    personB
    {
        type box;
        min  (3.5 1.8 -0.1);
        max  (3.9 2.2 1.3);
    }

    // Refinement regions
    diffuserRegion
    {
        type box;
        min  (2.0 1.5 2.6);
        max  (3.0 2.5 2.9);
    }
    ceilingRegion
    {
        type box;
        min  (-0.1 -0.1 2.5);
        max  (5.1 4.1 2.9);
    }
    facadeRegion
    {
        type box;
        min  (-0.1 -0.1 -0.1);
        max  (5.1 0.2 2.9);
    }
};

castellatedMeshControls
{
    nCellsBetweenLevels 2;

    refinementSurfaces
    {
        "desk.*"
        {
            level (2 2);
            patchInfo { type wall; }
        }

        "pc.*"
        {
            level (2 2);
            patchInfo { type wall; }
        }

        "person.*"
        {
            level (1 1);
            patchInfo { type wall; }
        }
    }

    refinementRegions
    {
        // 0.025 m cells around the ceiling diffuser slots
        diffuserRegion
        {
            mode    inside;
            level   2;
        }

        // 0.05 m cells for the jets attached to the ceiling
        ceilingRegion
        {
            mode    inside;
            level   1;
        }

        // 0.05 m cells for the boundary layer on the facade and window
        facadeRegion
        {
            mode    inside;
            level   1;
        }
    }

    insidePoint (0.2627 3.7381 1.9513);
}

snapControls
{
    explicitFeatureSnap    false;
    implicitFeatureSnap    true;
}

addLayersControls
{
    layers
    {}

    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        0.1;
}

writeFlags
(
);

mergeTolerance 1e-6;

// ************************************************************************* //
