FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      comfortFunctions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Thermal comfort post-processing to EN ISO 7730, run by Allrun once the
// flow has converged:
//
//     foamPostProcess -solver fluid -latestTime -dict system/comfortFunctions
//
// Writes the fields PMV, PPD [%], DR (draught rate) [%] and age (age of air)
// [s] and averages them over the occupied zone.

comfort
{
    type            comfort;
    libs            ("libfieldFunctionObjects.so");

    clothing        0.5;        // [clo] summer office clothing
    metabolicRate   1.2;        // [met] sedentary office work
    extWork         0;          // [met]
    relHumidity     50;         // [%]

    // Mean radiant temperature [K]. Allrun replaces this with the
    // area-averaged room envelope temperature (postProcessing/envelopeT).
    // Without Trad, the comfort function would average over all wall
    // patches, including the hot surfaces of people and computers.
    Trad            297.15;
}

age
{
    type            age;
    libs            ("libsolverFunctionObjects.so");
    diffusion       on;
}

// Occupied zone: 1.0 m from the facade, 0.5 m from the internal walls,
// 0.1 m to 1.8 m above the floor (typical limits from EN 16798-1 / CR 1752).
// The air within 0.1 m of the people and in the plumes above the computers
// is excluded so that min and max describe the room air, not the heat
// sources.
occupiedZoneMean
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    cellZone
    {
        type        difference;

        room
        {
            type        box;
            zoneType    cell;
            box         (0.5 1.0 0.1) (4.5 3.5 1.8);
        }

        heatSources
        {
            type        box;
            zoneType    cell;
            boxes
            (
                (0.9 0.9 0.6) (1.7 1.3 1.8)     // pcA and its plume
                (3.3 0.9 0.6) (4.1 1.3 1.8)     // pcB and its plume
                (1.0 1.7 0.0) (1.6 2.3 1.4)     // personA
                (3.4 1.7 0.0) (4.0 2.3 1.4)     // personB
            );
        }
    }
    fields          (T PMV PPD DR age);
    operation       volAverage;
    writeFields     false;
    log             yes;
}

occupiedZoneMin
{
    $occupiedZoneMean;
    operation       min;
}

occupiedZoneMax
{
    $occupiedZoneMean;
    operation       max;
}

// ************************************************************************* //
