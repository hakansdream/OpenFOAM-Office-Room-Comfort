FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            smoother        GaussSeidel;
        }
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }

    age
    {
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.001;
    }
}

// Settings of the roomHeating tutorial. The momentum predictor makes this
// case diverge in steady state.
PIMPLE
{
    momentumPredictor no;
    nNonOrthogonalCorrectors 0;

    residualControl
    {
        p_rgh           1e-4;
        U               1e-5;
        e               1e-5;
        "(k|omega)"     1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
        rho             0.01;
    }
    equations
    {
        U               0.7;
        ".*"            0.7;
        age             1;
    }
}

