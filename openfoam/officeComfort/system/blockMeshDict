FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Office room: 5.0 m (x, along the facade) x 4.0 m (y, room depth)
// x 2.8 m (z, height). The facade with the window is at y = 0.
// Background cells are 0.1 m; snappyHexMesh refines where needed.

vertices
(
    (0 0 0)
    (5 0 0)
    (5 4 0)
    (0 4 0)
    (0 0 2.8)
    (5 0 2.8)
    (5 4 2.8)
    (0 4 2.8)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (50 40 28) simpleGrading (1 1 1)
);

boundary
(
    floor
    {
        type wall;
        faces ((0 3 2 1));
    }

    ceiling
    {
        type wall;
        faces ((4 5 6 7));
    }

    // External wall (the window is cut out of it by createPatch)
    facade
    {
        type wall;
        faces ((0 1 5 4));
    }

    // Internal walls to the corridor and the neighbouring offices
    walls
    {
        type wall;
        faces
        (
            (3 7 6 2)
            (0 4 7 3)
            (1 2 6 5)
        );
    }
);

