FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [turbulentKineticEnergy];

internalField   uniform 1e-3;

boundaryField
{
    wall
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    "supply.*"
    {
        type            turbulentKineticEnergy;
        intensity       0.1;
        value           $internalField;
    }

    return
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}

