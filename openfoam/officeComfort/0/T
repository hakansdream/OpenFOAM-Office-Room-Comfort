FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Summer design day, cooling with an all-air system
Tsupply         291.15;     // [K] supply air 18 degC
Toutside        305.15;     // [K] outdoor air 32 degC

dimensions      [temperature];

internalField   uniform 297.15;

boundaryField
{
    // Internal walls, floor, ceiling and furniture: adiabatic
    wall
    {
        type            zeroGradient;
    }

    // External wall, U = 0.35 W/m^2/K.
    // h is the conductance from the inner surface to the outdoor air,
    // h = 1/(1/U - Rsi) with Rsi = 0.13 m^2K/W (the inner surface
    // resistance is resolved by the wall function).
    facade
    {
        type            externalTemperature;
        Ta              constant $Toutside;
        h               uniform 0.37;
        value           $internalField;
    }

    // Double glazing, U = 1.3 W/m^2/K. Solar gain is not included,
    // see README.md.
    window
    {
        type            externalTemperature;
        Ta              constant $Toutside;
        h               uniform 1.56;
        value           $internalField;
    }

    // Sensible heat gains
    personA
    {
        type            externalTemperature;
        Q               constant 75;        // [W] seated office work
        value           $internalField;
    }

    personB
    {
        $personA;
    }

    pcA
    {
        type            externalTemperature;
        Q               constant 100;       // [W] computer + monitor
        value           $internalField;
    }

    pcB
    {
        $pcA;
    }

    lights
    {
        type            externalTemperature;
        Q               constant 140;       // [W] 4 x 35 W LED panels
        value           $internalField;
    }

    "supply.*"
    {
        type            fixedValue;
        value           uniform $Tsupply;
    }

    return
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}

