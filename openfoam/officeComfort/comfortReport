#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Prints the air balance, heat balance and thermal comfort results averaged
# over the last 500 iterations. Run ./Allrun first.

pp=postProcessing

# Data file of a function object in its latest time directory
dataFile()
{
    ls -d $pp/$1/*/$2 2>/dev/null | sort -t/ -k3 -g | tail -1
}

# Average of column $2 of file $1 over the last 500 iterations
average()
{
    awk -v c="$2" '!/^#/ && NF {t[n] = $1; v[n++] = $c}
        END {for (i = 0; i < n; i++) if (t[i] > t[n-1] - 500) {s += v[i]; m++}
            print s/m}' "$1"
}

# Boussinesq air properties
props=constant/physicalProperties
rho0=$(foamDictionary -entry mixture/equationOfState/rho0 -value $props)
T0=$(foamDictionary -entry mixture/equationOfState/T0 -value $props)
beta=$(foamDictionary -entry mixture/equationOfState/beta -value $props)
Cv=$(foamDictionary -entry mixture/thermodynamics/Cv -value $props)
W=$(foamDictionary -entry mixture/specie/molWeight -value $props)
cp=$(awk -v Cv="$Cv" -v W="$W" 'BEGIN {print Cv + 8314.47/W}')

Tsupply=$(foamDictionary -entry Tsupply -value 0/T)
mSupply=$(average "$(dataFile supplyFlowRate surfaceFieldValue.dat)" 2)
mReturn=$(average "$(dataFile returnFlowRate surfaceFieldValue.dat)" 2)
Treturn=$(average "$(dataFile returnT surfaceFieldValue.dat)" 2)
Tmean=$(average "$(dataFile Tmean volFieldValue.dat)" 2)
Trad=$(average "$(dataFile envelopeT surfaceFieldValue.dat)" 2)

# Sum of the heat flows into the air through all wall patches
Qwalls=$(awk '!/^#/ && NF {if (!($1 in Q)) t[n++] = $1; Q[$1] += $5}
    END {for (i = 0; i < n; i++) if (t[i] > t[n-1] - 500) {s += Q[t[i]]; m++}
        print s/m}' "$(dataFile wallHeatFlux wallHeatFlux.dat)")

echo
echo "Air balance"
awk -v ms="$mSupply" -v mr="$mReturn" -v Ts="$Tsupply" -v Tr="$Treturn" \
    -v rho0="$rho0" -v T0="$T0" -v beta="$beta" '
    function abs(x) {return x < 0 ? -x : x}
    function rho(T) {return rho0*(1 - beta*(T - T0))}
    BEGIN {
        printf "    Supply air            %6.1f m3/h at %5.1f degC\n",
            abs(ms)/rho(Ts)*3600, Ts - 273.15
        printf "    Return air            %6.1f m3/h at %5.1f degC\n",
            abs(mr)/rho(Tr)*3600, Tr - 273.15
    }'

echo
echo "Heat balance"
awk -v ms="$mSupply" -v Ts="$Tsupply" -v Tr="$Treturn" -v cp="$cp" \
    -v Qw="$Qwalls" 'function abs(x) {return x < 0 ? -x : x}
    BEGIN {
        printf "    Removed by the air    %6.0f W   (m cp (T_return - T_supply))\n",
            abs(ms)*cp*(Tr - Ts)
        printf "    Heat gains            %6.0f W   (people, computers, lights, facade)\n",
            Qw
    }'

echo
echo "Room temperatures"
awk -v Tm="$Tmean" -v Tr="$Trad" 'BEGIN {
        printf "    Mean air              %6.1f degC\n", Tm - 273.15
        printf "    Mean radiant          %6.1f degC\n", Tr - 273.15
    }'

echo
echo "Occupied zone             mean      min      max"
fMean=$(dataFile occupiedZoneMean volFieldValue.dat)
fMin=$(dataFile occupiedZoneMin volFieldValue.dat)
fMax=$(dataFile occupiedZoneMax volFieldValue.dat)

# Average of the means, lowest minimum and highest maximum of the solutions.
# Columns: Time T PMV PPD DR age
row()
{
    awk -v name="$1" -v c="$2" -v off="$3" -v scale="$4" -v fmt="$5" '
        FNR == 1 {f++}
        !/^#/ && NF {
            v = ($c - off)*scale
            if (f == 1) {mean += v; n++}
            if (f == 2 && (lo == "" || v < lo)) lo = v
            if (f == 3 && (hi == "" || v > hi)) hi = v
        }
        END {printf "    %-18s" fmt fmt fmt "\n", name, mean/n, lo, hi}
    ' "$fMean" "$fMin" "$fMax"
}

row "T [degC]"          2 273.15 1         "%9.1f"
row "PMV [-]"           3 0      1         "%9.2f"
row "PPD [%]"           4 0      1         "%9.1f"
row "DR [%]"            5 0      1         "%9.1f"
row "Age of air [min]"  6 0      0.0166667 "%9.1f"
echo
